APP_NAME=AI Legal Decision Intelligence Engine
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local development may leave these blank for one-time local browser signup after migrations.
# Production must configure exactly one advocate account with app.core.setup_auth.
ADVOCATE_EMAIL=
ADVOCATE_PASSWORD_HASH=
SESSION_SECRET=
# Generated by `python -m app.core.setup_auth`; keep stable and backed up securely.
APP_ENCRYPTION_KEY=
# Set true only after a separate secure backup of APP_ENCRYPTION_KEY has been verified.
APP_ENCRYPTION_KEY_BACKUP_CONFIRMED=false
SESSION_TTL_SECONDS=28800
# Login lockout: 5 failed attempts in 15 minutes (per client IP).
LOGIN_ATTEMPT_LIMIT=5
LOGIN_WINDOW_SECONDS=900
DATABASE_URL=postgresql+psycopg://legal_engine:local_dev_only@127.0.0.1:5432/legal_engine
UPLOADS_DIR=../data/uploads
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_UPLOAD_FILES_PER_BATCH=10
MAX_CASE_DOCUMENTS=200
MAX_CASE_STORAGE_BYTES=1073741824
# In production this must point to the ClamAV clamscan executable; uploads fail closed without it.
CLAMAV_COMMAND=
TESSERACT_CMD=
# Pages below this OCR confidence are marked needs_review and their facts are down-weighted.
OCR_REVIEW_CONFIDENCE_THRESHOLD=70
# OpenNyAI is opt-in; its KING baseline is weak and judgment-domain only.
LEGAL_NER_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
# Paid is required for real case files. Free is available only for local synthetic-data testing.
GEMINI_DATA_TIER=disabled
# Module 3 knowledge graph (set true after Neo4j is running and credentials below match).
KNOWLEDGE_GRAPH_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
# Local development only; set the same value in the project-root .env before compose up.
NEO4J_PASSWORD=local_graph_dev_only
NEO4J_DATABASE=neo4j
# Production only: use TLS and confirm the underlying Neo4j volume/disk is encrypted.
NEO4J_STORAGE_ENCRYPTION_CONFIRMED=false
# First use downloads this English model from Hugging Face (384-dimensional vectors).
GRAPH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GRAPH_EMBEDDING_DIMENSIONS=384
# Module 4 legal research providers. India Code is a public read-only JSON API.
INDIACODE_API_BASE_URL=https://indiacode.ecourtsindia.com/api/v1
# Indian Kanoon: configure either a shared token, or the private key plus the
# registered Indian Kanoon customer email. Never put credentials in browser code.
INDIANKANOON_API_BASE_URL=https://api.indiankanoon.org
INDIANKANOON_API_TOKEN=
INDIANKANOON_PRIVATE_KEY=
INDIANKANOON_PRIVATE_KEY_PATH=secrets/indiankanoon_private.pem
INDIANKANOON_CUSTOMER_EMAIL=
LEGAL_RESEARCH_CACHE_TTL_SECONDS=300
LEGAL_RESEARCH_SEARCHES_PER_MINUTE=12
CHAT_MESSAGES_PER_MINUTE=12
